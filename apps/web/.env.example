# Firebase project configuration (Project settings → General → Your apps → SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Messaging Web Push certificate (Project settings → Cloud Messaging → Web configuration)
VITE_FIREBASE_VAPID_KEY=

# Mapbox — not used on public pages yet, required for the future partner map view
VITE_MAPBOX_TOKEN=

# Stripe — scaffolded only, no live payment flow in this v1 (see /integrations/stripe)
VITE_STRIPE_PUBLISHABLE_KEY=

# Didit KYC — scaffolded only, not active in this v1 (see /integrations/didit)
VITE_DIDIT_CLIENT_ID=
